# LLM provider: "groq" (free tier, needs GROQ_API_KEY) or "ollama" (local, no key, no limits)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional: leave empty for the provider default
# (groq: openai/gpt-oss-120b, judge openai/gpt-oss-20b; ollama: qwen3.5:4b for both)
# LLM_MODEL=
# JUDGE_MODEL=

# Only used when LLM_PROVIDER=ollama (first run: ollama pull qwen3.5:4b)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192

# Optional: LangSmith tracing (free Developer plan, https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=statline-agent
# Only for an EU LangSmith account:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Public demo only: questions per visitor (0 = no limit)
# DEMO_MAX_QUESTIONS=10
